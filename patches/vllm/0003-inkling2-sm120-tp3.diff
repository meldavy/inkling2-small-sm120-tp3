+"""Load-time attention head padding for tensor-parallel sizes that do not divide
+the Inkling 2 KV heads (e.g. TP=3 with 8 KV heads).
+
+The config hook (`pad_config_for_tp`) raises the head counts to the next
+multiple of the TP size; the loaders pass each attention tensor through
+`pad_attn_tensor` / `pad_draft_tensor`. Every added KV group copies the last KV
+head and the query heads of its group (so value norms and L2 clips stay
+finite) and gets zero output-projection columns, so it contributes exactly
+nothing: the padded model computes the same function as the checkpoint.
+"""
+from __future__ import annotations
+
+import re
+
+import torch
+
+PAD_ATTR = "inkling2_tp_pad"  # {"q": checkpoint query heads, "kv": checkpoint KV heads}
+
+
+def pad_config_for_tp(vllm_config) -> None:
+    tp = vllm_config.parallel_config.tensor_parallel_size
+    model_config = vllm_config.model_config
+    text = model_config.hf_text_config
+    kv, q = text.num_key_value_heads, text.num_attention_heads
+    if tp <= 1 or kv % tp == 0 or getattr(text, PAD_ATTR, None):
+        return
+    if (text.swa_num_key_value_heads, text.swa_num_attention_heads) != (kv, q) or q % kv:
+        raise ValueError("Inkling2 TP head padding expects equal full/SWA head counts")
+    new_kv = -(-kv // tp) * tp
+    new_q = new_kv * (q // kv)
+    setattr(text, PAD_ATTR, {"q": q, "kv": kv})
+    text.num_key_value_heads = text.swa_num_key_value_heads = new_kv
+    text.num_attention_heads = text.swa_num_attention_heads = new_q
+    mtp = getattr(model_config.hf_config, "mtp_config", None)
+    if isinstance(mtp, dict) and mtp.get("num_key_value_heads") == kv:
+        mtp["num_attention_heads"], mtp["num_key_value_heads"] = new_q, new_kv
+        mtp[PAD_ATTR] = {"q": q, "kv": kv}
+    model_config.model_arch_config = model_config.get_model_arch_config()
+    # The DSpark draft config is built from mtp_config before this hook runs.
+    spec = getattr(vllm_config, "speculative_config", None)
+    dmc = getattr(spec, "draft_model_config", None) if spec is not None else None
+    draft = getattr(dmc, "hf_config", None)
+    if draft is not None and getattr(draft, "model_type", "") == "inkling2_dspark"             and draft.num_key_value_heads == kv and not getattr(draft, PAD_ATTR, None):
+        draft.num_attention_heads, draft.num_key_value_heads = new_q, new_kv
+        setattr(draft, PAD_ATTR, {"q": q, "kv": kv})
+        if getattr(dmc, "hf_text_config", None) is not None and dmc.hf_text_config is not draft:
+            dmc.hf_text_config.num_attention_heads = new_q
+            dmc.hf_text_config.num_key_value_heads = new_kv
+
+
+def _pad_rows(t: torch.Tensor, per: int, heads: list[int]) -> torch.Tensor:
+    return torch.cat([t, *(t[h * per:(h + 1) * per] for h in heads)])
+
+
+def _plan(pad: dict, new_kv: int):
+    q, kv = pad["q"], pad["kv"]
+    g = q // kv
+    extra = new_kv - kv
+    kv_heads = [kv - 1] * extra
+    q_heads = list(range(q - g, q)) * extra
+    return g, extra, kv_heads, q_heads
+
+
+def pad_attn_tensor(local: str, t: torch.Tensor, pad: dict, new_kv: int,
+                    head_dim: int, rel_dim: int, kernel: int) -> torch.Tensor:
+    """Pad one target-model attention tensor; `local` is the name after `layers.N.`."""
+    g, extra, kv_heads, q_heads = _plan(pad, new_kv)
+    if local in ("attn.wq_du.weight", "attn.gate_attn.weight"):
+        return _pad_rows(t, head_dim, q_heads)
+    if local == "attn.wr_du.weight":
+        return _pad_rows(t, rel_dim, q_heads)
+    if local in ("attn.attn_sink_proj.weight", "attn.q_l2_clip.scale", "attn.rel_l2_clip.scale"):
+        return _pad_rows(t, 1, q_heads)
+    if local in ("attn.wk_dv.weight", "attn.wv_dv.weight", "attn.k_sconv.weight", "attn.v_sconv.weight"):
+        return _pad_rows(t, head_dim, kv_heads)
+    if local in ("attn.k_sconv.static_w", "attn.v_sconv.static_w"):  # [W, Hkv*D]
+        return torch.cat([t, *(t[:, h * head_dim:(h + 1) * head_dim] for h in kv_heads)], dim=1)
+    if local in ("attn.k_sconv.weight_proj", "attn.v_sconv.weight_proj"):  # [Hkv*W, H]
+        return _pad_rows(t, kernel, kv_heads)
+    if local == "attn.wo_ud.weight":  # [H, Hq*D]
+        return torch.cat([t, t.new_zeros(t.shape[0], extra * g * head_dim)], dim=1)
+    if local.startswith("attn.") and local != "attn.rel_logits_proj.proj":
+        raise ValueError(f"Inkling2 TP padding: unhandled attention tensor {local} {tuple(t.shape)}")
+    return t
+
+
+def pad_draft_tensor(name: str, t: torch.Tensor, pad: dict, new_kv: int, head_dim: int) -> torch.Tensor:
+    """Pad one DSpark/MTP drafter tensor (checkpoint name)."""
+    g, extra, kv_heads, q_heads = _plan(pad, new_kv)
+    if name.endswith("self_attn.q_proj.weight"):
+        return _pad_rows(t, head_dim, q_heads)
+    if re.search(r"self_attn\.(k|v)_proj(_ctx)?\.weight$", name):
+        return _pad_rows(t, head_dim, kv_heads)
+    if name.endswith("self_attn.o_proj.weight"):
+        return torch.cat([t, t.new_zeros(t.shape[0], extra * g * head_dim)], dim=1)
+    if "self_attn." in name and not re.search(r"(q|k)_norm(_ctx)?\.weight$", name):
+        raise ValueError(f"Inkling2 TP padding: unhandled drafter tensor {name} {tuple(t.shape)}")
+    return t
