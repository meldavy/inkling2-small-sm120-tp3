@@ -0,0 +1,104 @@
+# SPDX-License-Identifier: Apache-2.0
+"""DSpark draft-block attention on SM8x/SM12x (the Gluon `_rel_verify_kernel` needs SM100).
+
+Each request's `block` query tokens see all of its keys up to its last one (or the last `window`
+of them): plain paged attention without relative logits, gate or sink. Split-K over the context
+with an LSE combine, so the global draft layer stays parallel at long context.
+"""
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _block_attn_split_kernel(
+    q_ptr, k_ptr, v_ptr, bt_ptr, seqlen_ptr, cuq_ptr, po_ptr, pl_ptr,
+    stride_qt, stride_qh, stride_kb, stride_ks, stride_kh, stride_bt,
+    stride_po_s, stride_po_t, stride_po_h, stride_pl_s, stride_pl_t,
+    scale, window, PAGE: tl.constexpr, G: tl.constexpr, D: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, NS: tl.constexpr,
+):
+    sid = tl.program_id(0)
+    kvh = tl.program_id(1)
+    b = tl.program_id(2)
+    qs = tl.load(cuq_ptr + b)
+    qlen = tl.load(cuq_ptr + b + 1) - qs
+    L = tl.load(seqlen_ptr + b)
+    start = tl.maximum(L - window, 0) if window > 0 else 0
+    span = L - start
+    chunk = tl.cdiv(span, NS)
+    k0 = start + sid * chunk
+    k1 = tl.minimum(L, k0 + chunk)
+    m = tl.arange(0, BLOCK_M)
+    tok = m // G
+    head = kvh * G + m % G
+    rmask = tok < qlen
+    d = tl.arange(0, D)
+    q = tl.load(q_ptr + (qs + tok)[:, None] * stride_qt + head[:, None] * stride_qh + d[None, :],
+                mask=rmask[:, None], other=0.0)
+    m_i = tl.full((BLOCK_M,), float("-inf"), tl.float32)
+    l_i = tl.zeros((BLOCK_M,), tl.float32)
+    acc = tl.zeros((BLOCK_M, D), tl.float32)
+    for n0 in range(k0, k1, BLOCK_N):
+        n = n0 + tl.arange(0, BLOCK_N)
+        nmask = n < k1
+        page = tl.load(bt_ptr + b * stride_bt + n // PAGE, mask=nmask, other=0)
+        koff = page.to(tl.int64) * stride_kb + (n % PAGE) * stride_ks + kvh * stride_kh
+        k = tl.load(k_ptr + koff[:, None] + d[None, :], mask=nmask[:, None], other=0.0)
+        v = tl.load(v_ptr + koff[:, None] + d[None, :], mask=nmask[:, None], other=0.0)
+        s = tl.dot(q, tl.trans(k.to(q.dtype))) * scale
+        s = tl.where(nmask[None, :], s, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(s, 1))
+        m_safe = tl.where(m_new == float("-inf"), 0.0, m_new)
+        p = tl.exp(s - m_safe[:, None])
+        alpha = tl.exp(m_i - m_safe)
+        l_i = l_i * alpha + tl.sum(p, 1)
+        acc = acc * alpha[:, None] + tl.dot(p.to(q.dtype), v.to(q.dtype))
+        m_i = m_new
+    lse = tl.where(l_i > 0, m_i + tl.log(tl.maximum(l_i, 1e-30)), float("-inf"))
+    o = acc / tl.maximum(l_i, 1e-30)[:, None]
+    tl.store(po_ptr + sid * stride_po_s + (qs + tok)[:, None] * stride_po_t + head[:, None] * stride_po_h + d[None, :],
+             o, mask=rmask[:, None])
+    tl.store(pl_ptr + sid * stride_pl_s + (qs + tok) * stride_pl_t + head, lse, mask=rmask)
+
+
+@triton.jit
+def _block_attn_combine_kernel(po_ptr, pl_ptr, out_ptr, stride_po_s, stride_po_t, stride_po_h,
+                               stride_pl_s, stride_pl_t, stride_ot, H, NS: tl.constexpr, D: tl.constexpr):
+    t = tl.program_id(0)
+    h = tl.program_id(1)
+    d = tl.arange(0, D)
+    mx = float("-inf")
+    for s in tl.static_range(NS):
+        mx = tl.maximum(mx, tl.load(pl_ptr + s * stride_pl_s + t * stride_pl_t + h))
+    mx = tl.where(mx == float("-inf"), 0.0, mx)
+    acc = tl.zeros((D,), tl.float32)
+    wsum = 0.0
+    for s in tl.static_range(NS):
+        w = tl.exp(tl.load(pl_ptr + s * stride_pl_s + t * stride_pl_t + h) - mx)
+        acc += w * tl.load(po_ptr + s * stride_po_s + t * stride_po_t + h * stride_po_h + d)
+        wsum += w
+    tl.store(out_ptr + t * stride_ot + h * D + d, (acc / tl.maximum(wsum, 1e-30)).to(out_ptr.dtype.element_ty))
+
+
+def block_decode_attention_sm12x(q, key_cache, value_cache, out, *, block_table, cache_seqlens, cu_seqlens_q,
+                                 block, window, num_splits):
+    """Same contract as `block_decode_attention` (out: bf16 (T, H * D))."""
+    T, H, D = q.shape
+    num_blocks, page, num_kv_heads = key_cache.shape[:3]
+    assert key_cache.stride() == value_cache.stride() and key_cache.stride(3) == 1 and q.stride(2) == 1
+    G = H // num_kv_heads
+    R = cache_seqlens.shape[0]
+    ns = 8 if window > 0 else 32
+    block_m = max(16, triton.next_power_of_2(block * G))
+    po = torch.empty((ns, T, H, D), dtype=torch.float32, device=q.device)
+    pl = torch.full((ns, T, H), float("-inf"), dtype=torch.float32, device=q.device)
+    _block_attn_split_kernel[(ns, num_kv_heads, R)](
+        q, key_cache, value_cache, block_table, cache_seqlens, cu_seqlens_q, po, pl,
+        q.stride(0), q.stride(1), key_cache.stride(0), key_cache.stride(1), key_cache.stride(2), block_table.stride(0),
+        po.stride(0), po.stride(1), po.stride(2), pl.stride(0), pl.stride(1),
+        D ** -0.5, int(window), PAGE=page, G=G, D=D, BLOCK_M=block_m, BLOCK_N=32, NS=ns,
+        num_warps=4,
+    )
+    _block_attn_combine_kernel[(T, H)](po, pl, out, po.stride(0), po.stride(1), po.stride(2), pl.stride(0),
+                                       pl.stride(1), out.stride(0), H, NS=ns, D=D, num_warps=2)
