--- /dev/null
+++ b/vllm/models/inkling2/exl3_moe.py
@@ -0,0 +1,366 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Inkling2 routed experts as EXL3 (trellis, mul1 codebook) for SM12x.
+
+Drop-in for `Inkling2MoE` (same `forward(x) -> all-reduced bf16` contract on the
+non-fused path). Routing follows the reference: fp32 logits, sigmoid scores,
+top-k on `scores + bias`, weights renormalized and scaled by `route_scale`.
+The expert GEMMs run on ExLlamaV3 kernels with the Inkling2 activation
+(`4 tanh(g/4) sigmoid(g) * 25 tanh(u/25)`, act id 5 in the patched ext):
+cooperative decode for <= 8 tokens, decode-once grouped GEMM (xmoe_do) for
+prefill, the fused grouped kernel otherwise.
+
+Tensor parallelism splits every expert's intermediate axis (768 of 2304 per
+rank at TP3): w1/w3 keep output tile columns [r*I/16, (r+1)*I/16) and w2 the
+matching input tile rows; EXL3's Hadamard rotations act on 128-wide blocks,
+so a 128-aligned slice is exact.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+
+import regex as re
+import torch
+from torch import nn
+
+from vllm.distributed import (
+    get_tensor_model_parallel_rank,
+    get_tensor_model_parallel_world_size,
+    tensor_model_parallel_all_reduce,
+)
+from vllm.logger import init_logger
+
+from .moe import Inkling2Gate
+
+logger = init_logger(__name__)
+
+EXPERT_NAME = re.compile(
+    r"^model\.llm\.layers\.(\d+)\.mlp\.experts\.(\d+)\.(w[123])\.(trellis|suh|svh|mul1|mcg)$"
+)
+_ACT_INKLING2 = 5
+
+
+_COOP_MAX_ROWS = 8
+_FUSED_ROWS = int(os.environ.get("INKLING2_EXL3_FUSED_ROWS", "512"))
+_MTILE_T1, _MTILE_T2 = 16, 32
+_DO_ENABLED = os.environ.get("INKLING2_EXL3_DO", "1") == "1"
+_DO_DIR = os.environ.get("INKLING2_EXL3_DO_DIR", "")
+_DO_MIN_TOKENS = int(os.environ.get("INKLING2_EXL3_DO_MIN_TOKENS", "257"))
+_DO_TOKENS = int(os.environ.get("INKLING2_EXL3_DO_TOKENS", "4096"))
+# The decode-once path builds its job lists on the GPU (no host sync), so
+# prefill CUDA graphs can capture it.
+_DO_CAPTURE = os.environ.get("INKLING2_EXL3_DO_CAPTURE", "1") == "1"
+_DO_JOB_ROWS = 128
+
+_ext = None
+_do = None
+
+
+def use_exl3_experts() -> bool:
+    return os.environ.get("INKLING2_EXL3", "0") == "1"
+
+
+def _exllamav3_ext():
+    global _ext
+    if _ext is None:
+        import exllamav3_ext as ext
+
+        _ext = ext
+    return _ext
+
+
+def _do_ext():
+    global _do
+    if _do is None:
+        if _DO_DIR and _DO_DIR not in sys.path:
+            sys.path.insert(0, _DO_DIR)
+        import ds41_exl3_do as do
+
+        _do = do
+    return _do
+
+
+def ink_all_reduce(x: torch.Tensor) -> torch.Tensor:
+    """TP all-reduce of a layer's partial output."""
+    return tensor_model_parallel_all_reduce(x)
+
+
+class _Scratch:
+    _by_key: dict = {}
+
+    @classmethod
+    def get(cls, device, hidden, inter, topk):
+        key = (str(device), hidden, inter, topk)
+        if key not in cls._by_key:
+            cls._by_key[key] = cls(device, hidden, inter, topk)
+        return cls._by_key[key]
+
+    def __init__(self, device, hidden, inter, topk):
+        ext = _exllamav3_ext()
+        slots = _COOP_MAX_ROWS * topk
+        half = dict(dtype=torch.float16, device=device)
+        self.coop_had_g = torch.empty((slots, hidden), **half)
+        self.coop_had_u = torch.empty((slots, hidden), **half)
+        self.coop_gu_g = torch.empty((slots, inter), **half)
+        self.coop_gu_u = torch.empty((slots, inter), **half)
+        self.coop_act = torch.empty((slots, inter), **half)
+        self.coop_d_out = torch.empty((slots, hidden), dtype=torch.float32, device=device)
+        self.coop_out = torch.empty((_COOP_MAX_ROWS, hidden), dtype=torch.float32, device=device)
+        ctr_len = slots * (inter // 128) + _COOP_MAX_ROWS * (hidden // 128) + 2 + (slots + 1) + slots
+        self.coop_ctr = torch.zeros(ctr_len, dtype=torch.int32, device=device)
+        idx = torch.device(device).index or 0
+        c = max(1, int(ext.exl3_moe_max_concurrency(idx)))
+        self.temp_state_g = torch.empty((c, _FUSED_ROWS, hidden), **half)
+        self.temp_state_u = torch.empty((c, _FUSED_ROWS, hidden), **half)
+        self.temp_interm_g = torch.empty((c, _FUSED_ROWS, inter), **half)
+        self.temp_interm_u = torch.empty((c, _FUSED_ROWS, inter), **half)
+        self.device, self.hidden, self.inter, self.topk = device, hidden, inter, topk
+        self.do_rows = 0
+
+    def ensure_do(self, num_experts):
+        rows = _DO_TOKENS * self.topk
+        if self.do_rows >= rows:
+            return
+        half = dict(dtype=torch.float16, device=self.device)
+        self.do_xg = torch.empty((rows, self.hidden), **half)
+        self.do_xu = torch.empty((rows, self.hidden), **half)
+        self.do_cg = torch.empty((rows, self.inter), **half)
+        self.do_cu = torch.empty((rows, self.inter), **half)
+        jobs = -(-rows // _DO_JOB_ROWS) + num_experts
+        self.do_jobs = torch.arange(jobs, dtype=torch.int64, device=self.device)
+        self.do_rows = rows
+
+
+class Inkling2Exl3Experts(nn.Module):
+    def __init__(self, config, layer_id: int) -> None:
+        super().__init__()
+        self.layer_id = layer_id
+        self.tp_size = get_tensor_model_parallel_world_size()
+        self.tp_rank = get_tensor_model_parallel_rank()
+        self.num_experts = config.n_routed_experts
+        self.hidden = config.hidden_size
+        self.full_inter = config.intermediate_size
+        assert self.full_inter % (128 * self.tp_size) == 0
+        self.inter = self.full_inter // self.tp_size
+        self.topk = config.num_experts_per_tok
+        self.bits: int | None = None
+        self.st: dict[str, torch.Tensor] | None = None
+        self.pending: list = []
+        self.seen = 0
+        self.codebooks: set[str] = set()
+        self.flat_token_cache: dict[int, torch.Tensor] = {}
+
+    def _allocate(self, bits: int, device) -> None:
+        E, H, I, w = self.num_experts, self.hidden, self.inter, 16 * bits
+        i16 = dict(dtype=torch.int16, device=device)
+        f16 = dict(dtype=torch.float16, device=device)
+        self.st = {
+            "w1.trellis": torch.empty((E, H // 16, I // 16, w), **i16),
+            "w3.trellis": torch.empty((E, H // 16, I // 16, w), **i16),
+            "w2.trellis": torch.empty((E, I // 16, H // 16, w), **i16),
+            "w1.suh": torch.empty((E, H), **f16),
+            "w3.suh": torch.empty((E, H), **f16),
+            "w2.suh": torch.empty((E, I), **f16),
+            "w1.svh": torch.empty((E, I), **f16),
+            "w3.svh": torch.empty((E, I), **f16),
+            "w2.svh": torch.empty((E, H), **f16),
+        }
+        self.bits = bits
+
+    def load_exl3(self, expert: int, proj: str, kind: str, tensor: torch.Tensor, device) -> None:
+        if kind in ("mul1", "mcg"):
+            self.codebooks.add(kind)
+            return
+        if self.st is None:
+            if kind != "trellis":
+                self.pending.append((expert, proj, kind, tensor.clone()))
+                return
+            self._allocate(tensor.shape[-1] // 16, device)
+            for args in self.pending:
+                self.load_exl3(*args, device)
+            self.pending = []
+        r, I = self.tp_rank, self.inter
+        t16 = I // 16
+        if kind == "trellis":
+            if tensor.shape[-1] != 16 * self.bits:
+                raise ValueError(f"layer {self.layer_id}: mixed EXL3 bitrates in one layer")
+            src = tensor[:, r * t16:(r + 1) * t16, :] if proj in ("w1", "w3") else tensor[r * t16:(r + 1) * t16]
+        elif kind == "suh":
+            src = tensor if proj in ("w1", "w3") else tensor[r * I:(r + 1) * I]
+        elif kind == "svh":
+            src = tensor[r * I:(r + 1) * I] if proj in ("w1", "w3") else tensor
+        else:
+            raise ValueError(kind)
+        self.st[f"{proj}.{kind}"][expert].copy_(src)
+        self.seen += 1
+
+    def finalize(self) -> None:
+        if self.st is None or self.seen != 9 * self.num_experts:
+            raise ValueError(f"EXL3 layer {self.layer_id}: loaded {self.seen} of {9 * self.num_experts}")
+        if self.codebooks != {"mul1"}:
+            raise ValueError(f"EXL3 layer {self.layer_id}: codebooks {self.codebooks}, need mul1")
+
+        def ptrs(t):
+            stride = t[0].numel() * t.element_size()
+            return torch.tensor([t.data_ptr() + e * stride for e in range(t.shape[0])],
+                                dtype=torch.int64, device=t.device)
+
+        self.ptrs = {k: ptrs(v) for k, v in self.st.items()}
+        self.scratch = _Scratch.get(self.st["w1.trellis"].device, self.hidden, self.inter, self.topk)
+
+    # ---- compute ----------------------------------------------------------------
+
+    def forward(self, x: torch.Tensor, weights: torch.Tensor, ids: torch.Tensor) -> torch.Tensor:
+        tokens = x.shape[0]
+        if tokens == 0:
+            return torch.zeros((0, self.hidden), dtype=torch.float32, device=x.device)
+        xh = x.to(torch.float16)
+        if tokens <= _COOP_MAX_ROWS:
+            return self._coop(xh, weights, ids)
+        if _DO_ENABLED and tokens >= _DO_MIN_TOKENS and (_DO_CAPTURE or not torch.cuda.is_current_stream_capturing()):
+            return self._decode_once(xh, weights, ids)
+        return self._fused(xh, weights, ids)
+
+    def _coop(self, xh, w, ids):
+        ext, s, p = _exllamav3_ext(), self.scratch, self.ptrs
+        k = float(self.bits)
+        out = s.coop_out[: xh.shape[0]]
+        ext.exl3_moe_coop(
+            xh, ids.to(torch.int64).contiguous(), w.to(torch.float16).contiguous(),
+            0, self.num_experts, self.hidden,
+            p["w1.trellis"], p["w1.suh"], p["w1.svh"],
+            p["w3.trellis"], p["w3.suh"], p["w3.svh"],
+            p["w2.trellis"], p["w2.suh"], p["w2.svh"],
+            None, None, None,
+            k, k, k, False, True, _ACT_INKLING2, 0.0, True,
+            s.coop_had_g, s.coop_had_u, s.coop_gu_g, s.coop_gu_u, s.coop_act,
+            s.coop_d_out, s.coop_ctr, out, None, None,
+        )
+        return out
+
+    def _decode_once(self, xh, w, ids):
+        do, s, p = _do_ext(), self.scratch, self.ptrs
+        tokens, topk = ids.shape
+        E, dev = self.num_experts, xh.device
+        s.ensure_do(E)
+        out = torch.zeros((tokens, self.hidden), dtype=torch.float32, device=dev)
+        jobs = s.do_jobs
+        for t0 in range(0, tokens, _DO_TOKENS):
+            t1 = min(t0 + _DO_TOKENS, tokens)
+            fid = ids[t0:t1].reshape(-1).to(torch.int64)
+            fid = torch.where(fid < 0, E, fid)
+            order = torch.argsort(fid, stable=True)
+            row_exp = fid.index_select(0, order).to(torch.int32)
+            tok = torch.div(order, topk, rounding_mode="floor") + t0
+            wts = w[t0:t1].reshape(-1).index_select(0, order).to(torch.float16)
+            count = torch.zeros(E + 1, dtype=torch.int64, device=dev)
+            count.scatter_add_(0, fid, torch.ones_like(fid))
+            count = count[:E]
+            first_row = torch.cumsum(count, 0) - count
+            n_jobs = torch.div(count + _DO_JOB_ROWS - 1, _DO_JOB_ROWS, rounding_mode="floor")
+            job_end = torch.cumsum(n_jobs, 0)
+            job_exp = torch.searchsorted(job_end, jobs, right=True).clamp_(max=E - 1)
+            kk = jobs - (job_end - n_jobs).index_select(0, job_exp)
+            job_row0 = (first_row.index_select(0, job_exp) + _DO_JOB_ROWS * kk).to(torch.int32)
+            job_rows = (count.index_select(0, job_exp) - _DO_JOB_ROWS * kk).clamp_(0, _DO_JOB_ROWS)
+            do.do_moe(
+                xh, out, tok, wts, row_exp, job_row0, job_rows.to(torch.int32), job_exp,
+                p["w1.trellis"], p["w1.suh"], p["w1.svh"],
+                p["w3.trellis"], p["w3.suh"], p["w3.svh"],
+                p["w2.trellis"], p["w2.suh"], p["w2.svh"],
+                s.do_xg, s.do_xu, s.do_cg, s.do_cu,
+                self.bits, 2, 0.0, _ACT_INKLING2, E,
+            )
+        return out
+
+    def _flat_token(self, tokens, topk, device):
+        key = tokens * 64 + topk
+        if key not in self.flat_token_cache:
+            self.flat_token_cache[key] = torch.arange(tokens, device=device).repeat_interleave(topk)
+        return self.flat_token_cache[key]
+
+    def _fused(self, xh, w, ids):
+        ext, s, p = _exllamav3_ext(), self.scratch, self.ptrs
+        tokens, topk = ids.shape
+        E = self.num_experts
+        local = ids.reshape(-1).to(torch.int64)
+        local = torch.where(local < 0, E, local)
+        flat_w = w.reshape(-1).to(torch.float16)
+        flat_t = self._flat_token(tokens, topk, xh.device)
+        order = torch.argsort(local, stable=True)
+        token_sorted = flat_t.index_select(0, order)
+        weight_sorted = flat_w.index_select(0, order)
+        count = torch.zeros(E + 1, dtype=torch.int64, device=xh.device)
+        count.scatter_add_(0, local, torch.ones_like(local))
+        out = torch.zeros((tokens, self.hidden), dtype=torch.float32, device=xh.device)
+        k = float(self.bits)
+
+        def run(cnt, tok, wts, num_active, lo, hi, m_tile):
+            ext.exl3_moe(
+                xh, out, cnt, tok, wts,
+                s.temp_state_g, s.temp_state_u, s.temp_interm_g, s.temp_interm_u,
+                _ACT_INKLING2, k, k, k,
+                p["w1.trellis"], p["w1.suh"], p["w1.svh"],
+                p["w3.trellis"], p["w3.suh"], p["w3.svh"],
+                p["w2.trellis"], p["w2.suh"], p["w2.svh"],
+                False, True, False, True, False, True,
+                0.0, num_active, None, None, lo, hi, m_tile,
+            )
+
+        if tokens <= _FUSED_ROWS or torch.cuda.is_current_stream_capturing():
+            run(count, token_sorted, weight_sorted, -1, 1, _FUSED_ROWS, 16)
+            return out
+        counts = count[:E].tolist()
+        max_rows = max(counts)
+        if max_rows <= _FUSED_ROWS:
+            passes = [(count, token_sorted, weight_sorted, counts)]
+        else:
+            start = torch.cumsum(count, 0) - count
+            pos = torch.arange(local.numel(), device=xh.device) - start.index_select(
+                0, local.index_select(0, order))
+            passes = []
+            for lo_row in range(0, max_rows, _FUSED_ROWS):
+                keep = (pos >= lo_row) & (pos < lo_row + _FUSED_ROWS)
+                cnt = (count - lo_row).clamp(0, _FUSED_ROWS)
+                cnt[E] = 0
+                cl = [min(max(c - lo_row, 0), _FUSED_ROWS) for c in counts]
+                passes.append((cnt, token_sorted[keep], weight_sorted[keep], cl))
+        for cnt, tok, wts, cl in passes:
+            for n, lo, hi, m_tile in (
+                (sum(1 for c in cl if c > _MTILE_T2), _MTILE_T2 + 1, _FUSED_ROWS, 64),
+                (sum(1 for c in cl if _MTILE_T1 < c <= _MTILE_T2), _MTILE_T1 + 1, _MTILE_T2, 32),
+                (sum(1 for c in cl if 0 < c <= _MTILE_T1), 1, _MTILE_T1, 16),
+            ):
+                if n:
+                    run(cnt, tok, wts, n, lo, hi, m_tile)
+        return out
+
+
+class Inkling2Exl3MoE(nn.Module):
+    """`Inkling2MoE` with EXL3 experts (TP over the intermediate axis)."""
+
+    def __init__(self, config, layer_id: int) -> None:
+        super().__init__()
+        assert config.n_shared_experts == 0
+        self.gate = Inkling2Gate(config)
+        self.experts = Inkling2Exl3Experts(config, layer_id)
+        self.tp_size = get_tensor_model_parallel_world_size()
+
+    def route(self, x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        # bf16 x bf16 products are exact in fp32; fp32 accumulate + output
+        logits = torch.mm(x, self.gate.weight.t(), out_dtype=torch.float32)
+        scores = logits.sigmoid()
+        ids = torch.topk(scores + self.gate.bias, self.gate.topk, dim=-1, sorted=False).indices
+        w = scores.gather(1, ids)
+        w = w / (w.sum(-1, keepdim=True) + 1e-20) * self.gate.route_scale
+        return w, ids
+
+    def forward(self, x: torch.Tensor, reduce: bool = True, push=None, lora=None) -> torch.Tensor:
+        if push is not None or lora is not None or not reduce:
+            raise NotImplementedError("EXL3 experts support the plain all-reduce path only")
+        x = x.contiguous()
+        w, ids = self.route(x)
+        out = self.experts(x, w, ids).to(x.dtype)
+        return out if self.tp_size == 1 else ink_all_reduce(out)
