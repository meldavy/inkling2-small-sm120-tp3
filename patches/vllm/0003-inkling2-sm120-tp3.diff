+        block_q, block_k, warps = max(1, 16 // block_h), 64, 4
+    else:
+        block_q, block_k, warps = max(1, 64 // block_h), 64, 4
+    grid = (triton.cdiv(max_seqlen_q, block_q), HKV, batch)
+    _inkling2_rel_attn_kernel[grid](
+        q, key_cache, value_cache, sheared_bias, out, lse, block_table,
+        cache_seqlens, cu_seqlens_q,
+        gqa, softmax_scale,
+        q.stride(0), q.stride(1),
+        key_cache.stride(0), key_cache.stride(1), key_cache.stride(2),
+        value_cache.stride(0), value_cache.stride(1), value_cache.stride(2),
+        sheared_bias.stride(0), sheared_bias.stride(1),
+        out.stride(0), out.stride(1),
+        lse.stride(0), lse.stride(1),
+        block_table.stride(0),
+        PAGE=key_cache.shape[1], EXTENT=extent, WINDOW_LEFT=window_left,
+        BLOCK_Q=block_q, BLOCK_K=block_k, D=D, BLOCK_H=block_h,
+        num_warps=warps, num_stages=2,
+    )
+    return out
+
+
+# ---------------------------------------------------------------------------------------------
+# Split-KV decode for full (global) layers: each program owns one (split, kv head, request) and a
+# contiguous KV range [s*chunk, (s+1)*chunk) with chunk = ceil(kv_len / NUM_SPLITS) computed on the
+# device, so one launch shape serves every replay of a CUDA graph. Partials (m, l, acc) go to a
+# scratch buffer and a combine kernel writes the fp32 output and natural-log LSE.
+
+@triton.jit
+def _inkling2_rel_attn_split_kernel(
+    q_ptr, k_ptr, v_ptr, rel_ptr, pm_ptr, pl_ptr, pacc_ptr, block_table_ptr,
+    cache_seqlens, cu_seqlens_q,
+    gqa, softmax_scale,
+    s_q_t, s_q_h,
+    s_k_b, s_k_p, s_k_h,
+    s_v_b, s_v_p, s_v_h,
+    s_r_t, s_r_h,
+    s_bt_b,
+    HQ,
+    PAGE: tl.constexpr, EXTENT: tl.constexpr, NUM_SPLITS: tl.constexpr,
+    BLOCK_Q: tl.constexpr, BLOCK_K: tl.constexpr, D: tl.constexpr, BLOCK_H: tl.constexpr,
+    WINDOW_LEFT: tl.constexpr = -1,
+):
+    pid_s = tl.program_id(0)
+    pid_kh = tl.program_id(1)
+    pid_b = tl.program_id(2)
+    BLOCK_QH: tl.constexpr = BLOCK_Q * BLOCK_H
+    q_start = tl.load(cu_seqlens_q + pid_b)
+    q_len = tl.load(cu_seqlens_q + pid_b + 1) - q_start
+    kv_len = tl.load(cache_seqlens + pid_b)
+    prefix = kv_len - q_len
+    h0 = pid_kh * gqa
+    bt_row = block_table_ptr + pid_b.to(tl.int64) * s_bt_b
+
+    r = tl.arange(0, BLOCK_QH)
+    rq = r // BLOCK_H
+    rh = r % BLOCK_H
+    row_ok = (rq < q_len) & (rh < gqa)
+    head = h0 + rh
+    tok = (q_start + rq).to(tl.int64)
+    pos = prefix + rq
+    tile_end = tl.minimum((rq // 128 + 1) * 128, q_len)
+    n_max = (prefix + tile_end + 127) // 128
+    col0 = (n_max - 10) * 128
+    d = tl.arange(0, D)
+    q = tl.load(q_ptr + tok[:, None] * s_q_t + head[:, None] * s_q_h + d[None, :],
+                mask=row_ok[:, None], other=0.0)
+
+    start = 0
+    if WINDOW_LEFT >= 0:
+        start = tl.maximum(prefix - WINDOW_LEFT, 0)  # first query row's window start
+    span = kv_len - start
+    chunk = (span + NUM_SPLITS - 1) // NUM_SPLITS
+    chunk = ((chunk + BLOCK_K - 1) // BLOCK_K) * BLOCK_K
+    lo = start + pid_s * chunk
+    hi = tl.minimum(lo + chunk, kv_len)
+
+    m_i = tl.full((BLOCK_QH,), float("-inf"), tl.float32)
+    l_i = tl.zeros((BLOCK_QH,), tl.float32)
+    acc = tl.zeros((BLOCK_QH, D), tl.float32)
+    LOG2E: tl.constexpr = 1.4426950408889634
+    qk_scale = softmax_scale * LOG2E
+    for k_start in range(lo, hi, BLOCK_K):
+        kp = k_start + tl.arange(0, BLOCK_K)
+        k_ok = kp < hi
+        safe = tl.minimum(kp, kv_len - 1)
+        page = tl.load(bt_row + safe // PAGE).to(tl.int64)
+        poff = safe % PAGE
+        k = tl.load(k_ptr + page[None, :] * s_k_b + poff[None, :] * s_k_p + pid_kh * s_k_h + d[:, None],
+                    mask=k_ok[None, :], other=0.0)
+        s = tl.dot(q, k.to(q.dtype)) * qk_scale
+        dist = pos[:, None] - kp[None, :]
+        valid = row_ok[:, None] & k_ok[None, :] & (dist >= 0)
+        if WINDOW_LEFT >= 0:
+            valid &= dist <= WINDOW_LEFT
+        rel_ok = valid & (dist < EXTENT)
+        col = kp[None, :] - col0[:, None]
+        bias = tl.load(rel_ptr + tok[:, None] * s_r_t + head[:, None] * s_r_h + col, mask=rel_ok, other=0.0)
+        s += bias.to(tl.float32) * LOG2E
+        s = tl.where(valid, s, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(s, axis=1))
+        m_safe = tl.where(m_new == float("-inf"), 0.0, m_new)
+        alpha = tl.exp2(m_i - m_safe)
+        p = tl.exp2(s - m_safe[:, None])
+        l_i = l_i * alpha + tl.sum(p, axis=1)
+        acc = acc * alpha[:, None]
+        v = tl.load(v_ptr + page[:, None] * s_v_b + poff[:, None] * s_v_p + pid_kh * s_v_h + d[None, :],
+                    mask=k_ok[:, None], other=0.0)
+        acc += tl.dot(p.to(q.dtype), v.to(q.dtype))
+        m_i = m_new
+    # partial index: (token, head, split)
+    pidx = (tok * HQ + head) * NUM_SPLITS + pid_s
+    tl.store(pm_ptr + pidx, m_i, mask=row_ok)
+    tl.store(pl_ptr + pidx, l_i, mask=row_ok)
+    tl.store(pacc_ptr + pidx[:, None] * D + d[None, :], acc, mask=row_ok[:, None])
+
+
+@triton.jit
+def _inkling2_split_combine_kernel(
+    pm_ptr, pl_ptr, pacc_ptr, out_ptr, lse_ptr, s_o_t, s_o_h, s_l_h, s_l_t, HQ,
+    NUM_SPLITS: tl.constexpr, D: tl.constexpr,
+):
+    t = tl.program_id(0).to(tl.int64)
+    h = tl.program_id(1)
+    sp = tl.arange(0, NUM_SPLITS)
+    base = (t * HQ + h) * NUM_SPLITS
+    m = tl.load(pm_ptr + base + sp)
+    l = tl.load(pl_ptr + base + sp)
+    mx = tl.max(m, 0)
+    w = tl.where(m == float("-inf"), 0.0, tl.exp2(m - mx))
+    L = tl.sum(l * w, 0)
+    d = tl.arange(0, D)
+    acc = tl.load(pacc_ptr + (base + sp)[:, None] * D + d[None, :])
+    o = tl.sum(acc * w[:, None], 0) / L
+    tl.store(out_ptr + t * s_o_t + h * s_o_h + d, o)
+    tl.store(lse_ptr + h * s_l_h + t * s_l_t, (mx + tl.log2(L)) / 1.4426950408889634)
+
+
+SPLIT_KV_MAX_Q = 8
+SPLIT_KV_SPLITS = 32
+LOCAL_SPLITS = 8  # window 1024 -> 8 x 128 keys per split
+
+
+@torch.no_grad()
+def inkling2_rel_attention_sm12x_split(q, key_cache, value_cache, *, block_table, cache_seqlens,
+                                       cu_seqlens_q, max_seqlen_q, softmax_scale, sheared_bias, out, lse,
+                                       num_splits=SPLIT_KV_SPLITS, window_left=-1):
+    T, HQ, D = q.shape
+    HKV = key_cache.shape[2]
+    gqa = HQ // HKV
+    block_h = triton.next_power_of_2(gqa)
+    block_q = max(triton.next_power_of_2(max_seqlen_q), 16 // block_h)
+    batch = cu_seqlens_q.shape[0] - 1
+    extent = sheared_bias.shape[2] - 256
+    pm = torch.empty((T, HQ, num_splits), dtype=torch.float32, device=q.device)
+    pl = torch.empty_like(pm)
+    pacc = torch.empty((T, HQ, num_splits, D), dtype=torch.float32, device=q.device)
+    _inkling2_rel_attn_split_kernel[(num_splits, HKV, batch)](
+        q, key_cache, value_cache, sheared_bias, pm, pl, pacc, block_table,
+        cache_seqlens, cu_seqlens_q, gqa, softmax_scale,
+        q.stride(0), q.stride(1),
+        key_cache.stride(0), key_cache.stride(1), key_cache.stride(2),
+        value_cache.stride(0), value_cache.stride(1), value_cache.stride(2),
+        sheared_bias.stride(0), sheared_bias.stride(1), block_table.stride(0), HQ,
+        PAGE=key_cache.shape[1], EXTENT=extent, NUM_SPLITS=num_splits,
+        BLOCK_Q=block_q, BLOCK_K=64, D=D, BLOCK_H=block_h, WINDOW_LEFT=window_left,
+        num_warps=4, num_stages=2,
+    )
+    _inkling2_split_combine_kernel[(T, HQ)](
+        pm, pl, pacc, out, lse, out.stride(0), out.stride(1), lse.stride(0), lse.stride(1), HQ,
+        NUM_SPLITS=num_splits, D=D, num_warps=4,
+    )
+    return out
