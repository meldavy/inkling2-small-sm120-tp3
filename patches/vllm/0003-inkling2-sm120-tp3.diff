diff --git a/vllm/models/inkling2/conv_state.py b/vllm/models/inkling2/conv_state.py
new file mode 100644
index 000000000..cc28c3e48
--- /dev/null
+++ b/vllm/models/inkling2/conv_state.py
@@ -0,0 +1,333 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Inkling2 short-conv state as fixed per-request Mamba-style state.
+
+Replaces the per-token paged `InklingConvState` (a `SlidingWindowSpec` cache that
+stores every in-flight token's conv inputs, ~24 KiB/token/layer per rank at TP3)
+with the established short-conv pattern (LFM2 `ShortConv`, Qwen3-Next GDN conv,
+the Qwen4Exp PLE conv): one `MambaSpec` state per layer and request holding the
+last `W - 1` inputs of every conv stream.
+
+Layout per layer: `(L, H * Dp)` (the SD conv-state layout, oldest row first),
+with the PR's per-KV-head packing kept so the conv kernels index it unchanged::
+
+    Dp = head_dim (K) + head_dim (V) + hidden / H (attn-out) + hidden / H (mlp-out)
+
+Kernels see the `[slots, H, L, Dp]` view (`state_view`).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import torch
+from torch import nn
+
+from vllm.config import VllmConfig, get_current_vllm_config
+from vllm.distributed import get_tensor_model_parallel_world_size
+from vllm.model_executor.layers.mamba.abstract import MambaBase
+from vllm.model_executor.layers.mamba.mamba_utils import (
+    MambaStateCopyFuncCalculator,
+    MambaStateDtypeCalculator,
+)
+from vllm.models.inkling.nvidia.ops.sconv import sconv_seq_metadata
+from vllm.v1.attention.backend import AttentionCGSupport, CommonAttentionMetadata
+from vllm.v1.attention.backends.registry import MambaAttentionBackendEnum
+from vllm.v1.attention.backends.short_conv_attn import (
+    ShortConvAttentionBackend,
+    ShortConvAttentionMetadata,
+    ShortConvAttentionMetadataBuilder,
+)
+
+_K, _V, _ATTN, _MLP = 0, 1, 2, 3
+
+
+def conv_state_dims(num_kv_heads: int, head_dim: int, hidden_size: int, tp: int) -> tuple[int, int]:
+    """(H per rank, packed per-head width Dp) of the replicated-hidden layout."""
+    h = num_kv_heads // tp
+    return h, 2 * head_dim + 2 * (hidden_size // h)
+
+
+def conv_state_shape(config, vllm_config: VllmConfig) -> tuple[int, int]:
+    tp = vllm_config.parallel_config.tensor_parallel_size
+    h, dp = conv_state_dims(config.num_key_value_heads, config.head_dim, config.hidden_size, tp)
+    num_spec = vllm_config.num_speculative_tokens
+    return (config.sconv_kernel_size - 1 + num_spec, h * dp)
+
+
+@dataclass
+class Inkling2ConvStateMetadata(ShortConvAttentionMetadata):
+    # Per token (padded rows: slot -1).
+    token_slot: torch.Tensor | None = None
+    seq_idx: torch.Tensor | None = None
+    query_start: torch.Tensor | None = None
+    # Per request, in batch order.
+    req_slot: torch.Tensor | None = None
+    query_start_loc_all: torch.Tensor | None = None
+
+
+class Inkling2ConvStateMetadataBuilder(ShortConvAttentionMetadataBuilder):
+    _cudagraph_support: ClassVar[AttentionCGSupport] = AttentionCGSupport.UNIFORM_BATCH
+
+    def __init__(self, kv_cache_spec, layer_names, vllm_config, device) -> None:
+        super().__init__(kv_cache_spec, layer_names, vllm_config, device)
+        max_tokens = vllm_config.scheduler_config.max_num_batched_tokens
+        max_reqs = vllm_config.scheduler_config.max_num_seqs
+        i32 = dict(dtype=torch.int32, device=device)
+        self.seq_idx_buf = torch.zeros(max_tokens, **i32)
+        self.query_start_buf = torch.zeros(max_tokens, **i32)
+        self.token_slot_buf = torch.full((max_tokens,), -1, **i32)
+        self.req_slot_buf = torch.full((max_reqs + 1,), -1, **i32)
+
+    def build(self, common_prefix_len: int, common_attn_metadata: CommonAttentionMetadata,
+              fast_build: bool = False, **kwargs) -> Inkling2ConvStateMetadata:
+        md = super().build(common_prefix_len, common_attn_metadata, fast_build, **kwargs)
+        cm = common_attn_metadata
+        num_reqs = cm.num_reqs
+        num_actual = int(cm.query_start_loc_cpu[-1])
+        num_padded = cm.slot_mapping.shape[0] if cm.slot_mapping is not None else num_actual
+        num_padded = max(num_padded, num_actual)
+        # state slot per request (decodes first, then prefills: the batch order)
+        parts = []
+        if md.num_decodes:
+            d = md.state_indices_tensor_d
+            parts.append(d[:, 0] if d.dim() > 1 else d)
+        if md.num_prefills:
+            p = md.state_indices_tensor_p
+            parts.append((p[:, 0] if p.dim() > 1 else p)[: md.num_prefills])
+        req_slot = parts[0] if len(parts) == 1 else torch.cat(parts)
+        req_slot = req_slot[:num_reqs]
+        self.req_slot_buf[: req_slot.shape[0]].copy_(req_slot.to(torch.int32), non_blocking=True)
+        self.req_slot_buf[req_slot.shape[0]:].fill_(-1)
+        sconv_seq_metadata(cm.query_start_loc, num_reqs, num_actual, self.seq_idx_buf,
+                           self.query_start_buf, num_padded)
+        ts = self.token_slot_buf[:num_padded]
+        ts[:num_actual].copy_(self.req_slot_buf.index_select(0, self.seq_idx_buf[:num_actual].long()))
+        ts[num_actual:].fill_(-1)
+        md.token_slot = ts
+        md.seq_idx = self.seq_idx_buf[:num_padded]
+        md.query_start = self.query_start_buf[:num_padded]
+        md.req_slot = self.req_slot_buf[: cm.query_start_loc.shape[0] - 1]
+        md.query_start_loc_all = cm.query_start_loc
+        return md
+
+
+class Inkling2ConvStateBackend(ShortConvAttentionBackend):
+    @staticmethod
+    def get_name() -> str:
+        return "INKLING2_CONV_STATE"
+
+    @staticmethod
+    def get_builder_cls() -> type[Inkling2ConvStateMetadataBuilder]:
+        return Inkling2ConvStateMetadataBuilder
+
+
+def _flat_slots(t: torch.Tensor | None, n: int) -> torch.Tensor | None:
+    if t is None or n == 0:
+        return None
+    return (t[:, 0] if t.dim() > 1 else t)[:n]
+
+
+def conv_fields(owner: "Inkling2ConvState", md, num_tokens: int) -> dict:
+    """Per-token / per-request fields the sconv kernels need, derived from the
+    stock short-conv (Mamba) metadata once per KV-cache group and step."""
+    cached = getattr(md, "_ink2_fields", None)
+    if cached is not None and cached[0] == num_tokens:
+        return cached[1]
+    nsd = int(getattr(md, "num_spec_decodes", 0) or 0)
+    if nsd:
+        return _spec_conv_fields(owner, md, num_tokens, nsd)
+    nd, npf = md.num_decodes, md.num_prefills
+    num_actual = md.num_decode_tokens + md.num_prefill_tokens
+    num_reqs = nd + npf
+    b = owner.buffers()
+    qsl = b["qsl"]
+    if nd:
+        if md.query_start_loc_d is not None:
+            qsl[: nd + 1].copy_(md.query_start_loc_d[: nd + 1])
+        else:  # one token per decode row
+            qsl[: nd + 1].copy_(b["arange"][: nd + 1])
+    else:
+        qsl[:1].zero_()
+    if npf:
+        qsl[nd + 1 : nd + npf + 1].copy_(md.query_start_loc_p[1 : npf + 1] + md.num_decode_tokens)
+    req_slot = b["req_slot"][:num_reqs]
+    sd = _flat_slots(md.state_indices_tensor_d, nd)
+    sp = _flat_slots(md.state_indices_tensor_p, npf)
+    if sd is not None:
+        req_slot[:nd].copy_(sd)
+    if sp is not None:
+        req_slot[nd:].copy_(sp)
+    seq_idx, qstart, tslot = b["seq_idx"][:num_tokens], b["qstart"][:num_tokens], b["tslot"][:num_tokens]
+    sconv_seq_metadata(qsl, num_reqs, num_actual, b["seq_idx"], b["qstart"], num_tokens)
+    if num_actual:
+        tslot[:num_actual].copy_(req_slot.index_select(0, seq_idx[:num_actual].long()))
+    if num_tokens > num_actual:
+        tslot[num_actual:].fill_(-1)
+    fields = dict(token_slot=tslot, seq_idx=seq_idx, query_start=qstart,
+                  req_slot=req_slot, query_start_loc_all=qsl[: num_reqs + 1],
+                  pure_decode=(npf == 0 and md.num_decode_tokens == nd and owner.state_len == 3))
+    md._ink2_fields = (num_tokens, fields)
+    return fields
+
+
+def _spec_conv_fields(owner, md, num_tokens: int, nsd: int) -> dict:
+    """conv_fields for a batch with spec-decode requests: per request in batch
+    order, the state slot packed with its read offset (num_accepted - 1) and the
+    spec flag (see ops/sconv.py)."""
+    b = owner.buffers()
+    nd, npf = md.num_decodes, md.num_prefills
+    num_reqs = nsd + nd + npf
+    num_actual = int(getattr(md, "num_spec_decode_tokens", 0) or 0) + md.num_decode_tokens + md.num_prefill_tokens
+    qsl = b["qsl"]
+    qsl[: num_reqs + 1].copy_(md.query_start_loc[: num_reqs + 1])
+    mask = md.spec_sequence_masks[:num_reqs].to(torch.bool)
+    srank = (torch.cumsum(mask.to(torch.int32), 0) - 1).clamp_(min=0).long()
+    nrank = (torch.cumsum((~mask).to(torch.int32), 0) - 1).clamp_(min=0).long()
+    spec_slots = md.spec_state_indices_tensor
+    spec_slots = spec_slots[:, 0] if spec_slots.dim() > 1 else spec_slots
+    non_spec = md.state_indices_tensor
+    if non_spec is None or non_spec.numel() == 0:
+        non_spec = spec_slots.new_full((1,), -1)
+    non_spec = non_spec[:, 0] if non_spec.dim() > 1 else non_spec
+    slot = torch.where(mask, spec_slots.index_select(0, srank.clamp(max=spec_slots.numel() - 1)),
+                       non_spec.index_select(0, nrank.clamp(max=non_spec.numel() - 1))).to(torch.int32)
+    acc = md.num_accepted_tokens
+    acc = torch.where(mask, acc.index_select(0, srank.clamp(max=acc.numel() - 1)).to(torch.int32),
+                      torch.ones_like(slot))
+    off = (acc - 1).clamp_(0, 31)
+    packed = torch.where(slot >= 0, slot | (off << 24) | (mask.to(torch.int32) << 29), slot)
+    req_slot = b["req_slot"][:num_reqs]
+    req_slot.copy_(packed)
+    seq_idx, qstart, tslot = b["seq_idx"][:num_tokens], b["qstart"][:num_tokens], b["tslot"][:num_tokens]
+    sconv_seq_metadata(qsl, num_reqs, num_actual, b["seq_idx"], b["qstart"], num_tokens)
+    if num_actual:
+        tslot[:num_actual].copy_(req_slot.index_select(0, seq_idx[:num_actual].long()))
+    if num_tokens > num_actual:
+        tslot[num_actual:].fill_(-1)
+    fields = dict(token_slot=tslot, seq_idx=seq_idx, query_start=qstart, req_slot=req_slot,
+                  query_start_loc_all=qsl[: num_reqs + 1], pure_decode=False)
+    md._ink2_fields = (num_tokens, fields)
+    return fields
+
+
+_SPEC_CONV_BACKEND = None
+
+
+def _spec_conv_backend():
+    """PLE short-conv metadata (spec fields) for the spec-decode conv state. The
+    Inkling2 conv kernels take request boundaries and positions from the device
+    `query_start_loc` (see `_spec_conv_fields`), so adaptive verification's
+    on-device draft trimming is supported."""
+    global _SPEC_CONV_BACKEND
+    if _SPEC_CONV_BACKEND is None:
+        from vllm.v1.attention.backend import max_decode_query_len
+        from vllm.v1.attention.backends.short_conv_attn import (
+            PleShortConvAttentionBackend,
+            PleShortConvAttentionMetadataBuilder,
+        )
+
+        class Inkling2SpecConvBuilder(PleShortConvAttentionMetadataBuilder):
+            # FULL decode graphs replay verify batches of 1..max_decode_query_len
+            # tokens per request: the conv fields are derived in-graph from the
+            # device query_start_loc.
+            @classmethod
+            def get_varlen_cudagraph_max_query_len(cls, vllm_config, kv_cache_spec):
+                return max_decode_query_len(vllm_config)
+
+        class Inkling2SpecConvBackend(PleShortConvAttentionBackend):
+            @classmethod
+            def supports_device_cpu_query_lens_mismatch(cls) -> bool:
+                return True
+
+            @staticmethod
+            def get_builder_cls():
+                return Inkling2SpecConvBuilder
+
+        _SPEC_CONV_BACKEND = Inkling2SpecConvBackend
+    return _SPEC_CONV_BACKEND
+
+
+class Inkling2ConvState(nn.Module, MambaBase):
+    """Per-decoder-layer owner of the fixed conv state (K, V, attn-out, mlp-out)."""
+
+    def __init__(self, num_kv_heads: int, head_dim: int, hidden_size: int, kernel_size: int,
+                 prefix: str) -> None:
+        super().__init__()
+        tp = get_tensor_model_parallel_world_size()
+        assert tp <= num_kv_heads and num_kv_heads % tp == 0
+        self.prefix = prefix
+        self.num_kv_heads, self.width = conv_state_dims(num_kv_heads, head_dim, hidden_size, tp)
+        hidden_per_head = hidden_size // self.num_kv_heads
+        vllm_config = get_current_vllm_config()
+        self.state_len = kernel_size - 1 + vllm_config.num_speculative_tokens
+        self.kernel_size = kernel_size
+        self.stream_ranges: tuple[tuple[int, int], ...] = (
+            (0, head_dim),
+            (head_dim, head_dim),
+            (2 * head_dim, hidden_per_head),
+            (2 * head_dim + hidden_per_head, hidden_per_head),
+        )
+        self._max_tokens = vllm_config.scheduler_config.max_num_batched_tokens
+        self._max_reqs = vllm_config.scheduler_config.max_num_seqs + 1
+        self.model_config = vllm_config.model_config
+        self.cache_config = vllm_config.cache_config
+        self.kv_cache = (torch.tensor([]),)
+        cc = vllm_config.compilation_config
+        if prefix in cc.static_forward_context:
+            raise ValueError(f"Duplicate layer name: {prefix}")
+        cc.static_forward_context[prefix] = self
+
+    # --- MambaBase ---------------------------------------------------------------
+    def get_state_shape(self) -> tuple[tuple[int, int]]:
+        return ((self.state_len, self.num_kv_heads * self.width),)
+
+    def get_state_dtype(self) -> tuple[torch.dtype]:
+        return MambaStateDtypeCalculator.short_conv_state_dtype(
+            self.model_config.dtype, self.cache_config.mamba_cache_dtype
+        )
+
+    @property
+    def mamba_type(self) -> MambaAttentionBackendEnum:
+        return MambaAttentionBackendEnum.SHORT_CONV
+
+    def get_attn_backend(self):
+        # With speculative decoding the stock short-conv metadata has no spec
+        # fields (verify rows would run as plain decodes and keep rejected drafts
+        # in the state); the PLE short-conv backend builds them (spec masks, spec
+        # state slots, num_accepted_tokens) for `_spec_conv_fields`.
+        if self.state_len > self.kernel_size - 1:
+            return _spec_conv_backend()
+        return super().get_attn_backend()
+
+    # --- kernels -----------------------------------------------------------------
+    def buffers(self) -> dict:
+        key = "_bufs"
+        b = self.__dict__.get(key)
+        if b is None:
+            t, r = self._max_tokens, self._max_reqs
+            dev = torch.device("cuda", torch.cuda.current_device())
+            i32 = dict(dtype=torch.int32, device=dev)
+            b = dict(seq_idx=torch.zeros(t, **i32), qstart=torch.zeros(t, **i32),
+                     tslot=torch.full((t,), -1, **i32), req_slot=torch.full((r,), -1, **i32),
+                     qsl=torch.zeros(r + 1, **i32), arange=torch.arange(r + 1, **i32))
+            self.__dict__[key] = b
+        return b
+
+    @property
+    def bound(self) -> bool:
+        kv = self.kv_cache
+        return len(kv) > 0 and isinstance(kv[0], torch.Tensor) and kv[0].numel() > 0
+
+    def state_view(self) -> torch.Tensor:
+        """`[slots, H, L, Dp]` view (strides: slot, head, row) for the kernels."""
+        st = self.kv_cache[0]
+        return st.view(st.shape[0], self.state_len, self.num_kv_heads, self.width).permute(0, 2, 1, 3)
+
+    def forward(self):  # state owner only
+        raise NotImplementedError
+
+
+def inkling2_state_copy_funcs():
+    return MambaStateCopyFuncCalculator.short_conv_state_copy_func()
