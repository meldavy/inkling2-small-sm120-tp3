diff --git a/vllm/models/inkling2/ubatch.py b/vllm/models/inkling2/ubatch.py
new file mode 100644
index 000000000..8f3867424
--- /dev/null
+++ b/vllm/models/inkling2/ubatch.py
@@ -0,0 +1,225 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Microbatch-aware step metadata for Inkling2's two-microbatch prefill overlap.
+
+The model splits a batch's token rows into parts (`ub` = 1..N) that run
+staggered per layer, so each part's all-reduces overlap the other parts'
+compute. Only the eager graph breaks (attention and the
+stream convs) read per-step metadata; they call `step_attn_metadata()`,
+which returns the full batch's metadata outside a half, and otherwise that
+half's split, derived once per step. The split is generic: decode requests
+(which come first) stay in A, a request straddling `h` is cut in two, and
+the device tensors are derived with GPU ops, so nothing waits on the GPU.
+"""
+from __future__ import annotations
+
+import contextlib
+import dataclasses
+
+import numpy as np
+import torch
+
+from vllm.forward_context import get_forward_context
+
+from . import conv_state as _conv_state
+
+_CUR = [0, ()]  # (part: 0 = whole batch, k >= 1 = k-th part; part boundaries)
+
+
+@contextlib.contextmanager
+def ub_scope(ub: int, bounds: tuple):
+    prev = (_CUR[0], _CUR[1], _conv_state._UBATCH[0])
+    _CUR[0], _CUR[1] = ub, tuple(bounds)
+    _conv_state._UBATCH[0] = ub
+    try:
+        yield
+    finally:
+        _CUR[0], _CUR[1], _conv_state._UBATCH[0] = prev
+
+
+def step_attn_metadata():
+    """The step's metadata for the current part (None for a part holding only
+    padding: attention and convs then skip KV and state writes)."""
+    ctx = get_forward_context()
+    md = ctx.attn_metadata
+    ub, bounds = _CUR
+    if ub == 0 or not isinstance(md, dict):
+        return md
+    cache = getattr(ctx, "_ink2_ub_split", None)
+    if cache is None or cache[0] is not md or cache[1] != bounds:
+        cache = (md, bounds, split_parts(md, bounds))
+        ctx._ink2_ub_split = cache
+    return cache[2][ub - 1]
+
+
+def _num_actual(md_dict) -> int:
+    from .attention import Inkling2AttentionMetadata
+
+    for md in md_dict.values():
+        if isinstance(md, Inkling2AttentionMetadata):
+            return int(md.num_actual_tokens)
+    raise ValueError("Inkling2 microbatch split needs attention metadata")
+
+
+def split_parts(md_dict, bounds: tuple) -> list:
+    """Split at the given token boundaries into len(bounds) + 1 parts by chained
+    two-way splits; parts past the last real token are None."""
+    parts, rest, start = [], md_dict, 0
+    for b in bounds:
+        if rest is None:
+            parts.append(None)
+            continue
+        h = b - start
+        if h >= _num_actual(rest):
+            parts.append(rest)
+            rest = None
+        else:
+            a, rest = split_metadata(rest, h)
+            parts.append(a)
+        start = b
+    parts.append(rest)
+    return parts
+
+
+def _plan(md_dict, h: int):
+    from .attention import Inkling2AttentionMetadata
+
+    for md in md_dict.values():
+        if isinstance(md, Inkling2AttentionMetadata):
+            lens = np.asarray(md.query_lens_cpu, dtype=np.int64)
+            cu = np.zeros(len(lens) + 1, dtype=np.int64)
+            np.cumsum(lens, out=cu[1:])
+            n_actual = int(md.num_actual_tokens)
+            assert 0 < h < n_actual, (h, n_actual)
+            k_a = int(np.searchsorted(cu, h, side="left"))       # requests starting before h
+            j_b = int(np.searchsorted(cu, h, side="right")) - 1  # request holding token h
+            return cu, k_a, j_b, n_actual
+    raise ValueError("Inkling2 microbatch split needs attention metadata")
+
+
+def split_metadata(md_dict, h: int):
+    from vllm.v1.attention.backends.mamba_attn import BaseMambaAttentionMetadata
+
+    from .attention import Inkling2AttentionMetadata
+
+    cu, k_a, j_b, n_actual = _plan(md_dict, h)
+    memo, out_a, out_b = {}, {}, {}
+    for name, md in md_dict.items():
+        pair = memo.get(id(md))
+        if pair is None:
+            if isinstance(md, Inkling2AttentionMetadata):
+                pair = _split_attention(md, h, cu, k_a, j_b, n_actual)
+            elif isinstance(md, BaseMambaAttentionMetadata):
+                pair = _split_mamba(md, h, k_a, j_b, n_actual)
+            else:
+                # Other layers (the DSpark draft) do not run inside the target forward.
+                pair = (md, md)
+            memo[id(md)] = pair
+        out_a[name], out_b[name] = pair
+    return out_a, out_b
+
+
+def _split_attention(md, h, cu, k_a, j_b, n_actual):
+    nd = int(getattr(md, "num_decode_reqs", 0) or 0)
+    ndt = int(getattr(md, "num_decode_tokens", 0) or 0)
+    qsl = md.query_start_loc
+    seq_cpu = np.asarray(md.seq_lens_cpu, dtype=np.int64)
+    lens_a = np.minimum(cu[1 : k_a + 1], h) - cu[:k_a]
+    seq_a = seq_cpu[:k_a] - np.maximum(cu[1 : k_a + 1] - h, 0)
+    lens_b = cu[j_b + 1 :] - np.maximum(cu[j_b:-1], h)
+    seq_b = seq_cpu[j_b:]
+    a = dataclasses.replace(
+        md,
+        query_start_loc=torch.clamp(qsl[: k_a + 1], max=h),
+        seq_lens=md.seq_lens[:k_a] - torch.clamp(qsl[1 : k_a + 1] - h, min=0),
+        block_table=md.block_table[:k_a],
+        slot_mapping=md.slot_mapping[:h],
+        num_actual_tokens=h,
+        max_query_len=int(lens_a.max()),
+        max_seq_len=int(seq_a.max()),
+        query_lens_cpu=lens_a,
+        seq_lens_cpu=seq_a,
+    )
+    b = dataclasses.replace(
+        md,
+        query_start_loc=torch.clamp(qsl[j_b:] - h, min=0),
+        seq_lens=md.seq_lens[j_b:],
+        block_table=md.block_table[j_b:],
+        slot_mapping=md.slot_mapping[h:],
+        num_actual_tokens=n_actual - h,
+        max_query_len=int(lens_b.max()),
+        max_seq_len=int(seq_b.max()),
+        query_lens_cpu=lens_b,
+        seq_lens_cpu=seq_b,
+    )
+    a.num_decode_reqs, a.num_decode_tokens = nd, ndt
+    a.num_prefill_reqs, a.num_prefill_tokens = k_a - nd, h - ndt
+    b.num_decode_reqs, b.num_decode_tokens = 0, 0
+    b.num_prefill_reqs, b.num_prefill_tokens = len(lens_b), n_actual - h
+    return a, b
+
+
+def _split_mamba_spec(md, h, k_a, j_b, n_actual):
+    """PLE short-conv metadata with spec-decode (verify) rows. The batch is
+    verify rows, then plain decodes, then prefills; verify and decode rows all
+    land in part A (h > their tokens), part B holds prefills only."""
+    nsd, nst = md.num_spec_decodes, md.num_spec_decode_tokens
+    nd, ndt = md.num_decodes, md.num_decode_tokens
+    assert h > nst + ndt, (h, nst, ndt)
+    pre = nst + ndt  # first prefill token
+    qp = md.query_start_loc_p
+    sp = md.state_indices_tensor_p
+    npf_a = k_a - nd - nsd
+    first_b = j_b - nd - nsd
+    si = md.state_indices_tensor
+    a = dataclasses.replace(
+        md,
+        num_prefills=npf_a,
+        num_prefill_tokens=h - pre,
+        query_start_loc=torch.clamp(md.query_start_loc[: k_a + 1], max=h),
+        query_start_loc_p=None if qp is None else torch.clamp(qp[: npf_a + 1], max=h - pre),
+        state_indices_tensor_p=None if sp is None else sp[:npf_a],
+        state_indices_tensor=None if si is None else si[: nd + npf_a],
+    )
+    b = dataclasses.replace(
+        md,
+        num_spec_decodes=0,
+        num_spec_decode_tokens=0,
+        num_decodes=0,
+        num_decode_tokens=0,
+        query_start_loc_d=None,
+        state_indices_tensor_d=None,
+        num_prefills=md.num_prefills - first_b,
+        num_prefill_tokens=n_actual - h,
+        query_start_loc_p=torch.clamp(qp[first_b:] - (h - pre), min=0),
+        state_indices_tensor_p=None if sp is None else sp[first_b:],
+    )
+    return a, b
+
+
+def _split_mamba(md, h, k_a, j_b, n_actual):
+    if int(getattr(md, "num_spec_decodes", 0) or 0):
+        return _split_mamba_spec(md, h, k_a, j_b, n_actual)
+    nd, ndt = md.num_decodes, md.num_decode_tokens
+    qp = md.query_start_loc_p
+    sp = md.state_indices_tensor_p
+    npf_a = k_a - nd
+    first_b = j_b - nd  # index of B's first request among the prefills
+    a = dataclasses.replace(
+        md,
+        num_prefills=npf_a,
+        num_prefill_tokens=h - ndt,
+        query_start_loc_p=torch.clamp(qp[: npf_a + 1], max=h - ndt),
+        state_indices_tensor_p=None if sp is None else sp[:npf_a],
+    )
+    b = dataclasses.replace(
+        md,
+        num_decodes=0,
+        num_decode_tokens=0,
+        query_start_loc_d=None,
+        state_indices_tensor_d=None,
+        num_prefills=md.num_prefills - first_b,
+        num_prefill_tokens=n_actual - h,
+        query_start_loc_p=torch.clamp(qp[first_b:] - (h - ndt), min=0),
+        state_indices_tensor_p=None if sp is None else sp[first_b:],
+    )
+    return a, b
