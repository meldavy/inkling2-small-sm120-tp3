diff --git a/vllm/models/inkling2/ops/dma_allreduce.py b/vllm/models/inkling2/ops/dma_allreduce.py
new file mode 100644
index 000000000..100a99204
--- /dev/null
+++ b/vllm/models/inkling2/ops/dma_allreduce.py
@@ -0,0 +1,320 @@
+"""Host-staged copy-engine all-reduce for large (prefill) tensors on PCIe nodes without P2P.
+
+NCCL's SHM transport tops out at ~9.35 GB/s algbw on ampere (3x RTX PRO 6000, x16 Gen4,
+no peer access) while each GPU's copy engines sustain ~25.5 GB/s D2H and ~28.5 GB/s H2D
+concurrently. This runs a reduce-scatter + all-gather through one shared, registered host
+buffer with the data plane on copy engines and the cross-process handshake on stream memory
+operations (cuStreamWriteValue64 / cuStreamWaitValue64 on host-mapped 64-bit flags carrying
+a per-call epoch), so the host never blocks.
+
+Per call (S elements, owner shards of S/W, P pieces each), rank r:
+  d2h stream : copy x[o-shard piece] -> host in[r]   ; write flag_in[r][o][p] = epoch
+  h2d stream : wait flag_in[peer][r][p]  ; copy host in[peer][r-shard piece] -> scratch
+  main stream: out[r-shard piece] = x + scratch0 + scratch1 (fp32 accumulate, rank order)
+  d2h stream : copy out[r-shard piece] -> host red ; write flag_red[r][p] = epoch
+  h2d stream : wait flag_red[o][p] ; copy host red[o-shard piece] -> out
+Slot reuse is safe without double buffering: rank r only starts writing call e+1 after it saw
+every owner's flag_red for call e, i.e. after every owner finished reading in[r] for call e.
+"""
+from __future__ import annotations
+
+import ctypes
+import mmap
+import os
+import uuid
+
+import torch
+import torch.distributed as dist
+
+_SRC = r"""
+#include <torch/extension.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda.h>
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <vector>
+
+#define CK(x) do { cudaError_t _ck_err = (x); TORCH_CHECK(_ck_err == cudaSuccess, #x, ": ", cudaGetErrorString(_ck_err)); } while (0)
+#define CKD(x) do { CUresult _ckd_err = (x); TORCH_CHECK(_ckd_err == CUDA_SUCCESS, #x, " failed: ", (int)_ckd_err); } while (0)
+
+__global__ void sum3_bf16(const __nv_bfloat16* __restrict__ a, const __nv_bfloat16* __restrict__ b,
+                          const __nv_bfloat16* __restrict__ c, __nv_bfloat16* __restrict__ o,
+                          const int* order, long n) {
+    // rank-order fp32 accumulation: order[k] picks a/b/c for summand k
+    long i = (blockIdx.x * (long)blockDim.x + threadIdx.x) * 8;
+    if (i >= n) return;
+    const __nv_bfloat16* src[3] = {a, b, c};
+    float acc[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    for (int k = 0; k < 3; ++k) {
+        int4 v = *(const int4*)(src[order[k]] + i);
+        const __nv_bfloat16* h = (const __nv_bfloat16*)&v;
+        #pragma unroll
+        for (int j = 0; j < 8; ++j) acc[j] += __bfloat162float(h[j]);
+    }
+    int4 r; __nv_bfloat16* rh = (__nv_bfloat16*)&r;
+    #pragma unroll
+    for (int j = 0; j < 8; ++j) rh[j] = __float2bfloat16(acc[j]);
+    *(int4*)(o + i) = r;
+}
+
+struct State {
+    std::vector<cudaEvent_t> ev;
+    int* order_dev = nullptr;
+};
+static State g;
+
+static cudaEvent_t ev(int i) {
+    while ((int)g.ev.size() <= i) {
+        cudaEvent_t e; CK(cudaEventCreateWithFlags(&e, cudaEventDisableTiming)); g.ev.push_back(e);
+    }
+    return g.ev[i];
+}
+
+int64_t host_register(int64_t ptr, int64_t size) {
+    CK(cudaHostRegister((void*)ptr, size, cudaHostRegisterMapped | cudaHostRegisterPortable));
+    void* d = nullptr;
+    CK(cudaHostGetDevicePointer(&d, (void*)ptr, 0));
+    return (int64_t)d;
+}
+
+// host_in: base host ptr of in-slots [W][cap] bf16 ; host_red: [cap] bf16 ; flags: uint64 array
+// flag layout: in[src][owner][p] at ((src*W+owner)*P+p)*8 ; red[owner][p] at (W*W*P + owner*P + p)*8 (x8 u64 stride)
+void dma_allreduce(torch::Tensor x, torch::Tensor out, torch::Tensor scratch, int64_t host_in, int64_t host_red,
+                   int64_t flags_dev, int64_t cap, int64_t rank, int64_t world, int64_t epoch, int64_t P,
+                   int64_t s_d2h_i, int64_t s_h2d_i, int64_t s_d2h2_i, int64_t s_h2d2_i, torch::Tensor order) {
+    TORCH_CHECK(world == 3, "dma_allreduce: world 3 only");
+    const long n = x.numel();
+    TORCH_CHECK(n % (world * P * 8) == 0 && n <= cap, "dma_allreduce: bad size");
+    const long sh = n / world, pc = sh / P;
+    const size_t pcb = pc * 2;
+    cudaStream_t main = c10::cuda::getCurrentCUDAStream();
+    cudaStream_t sd = (cudaStream_t)s_d2h_i, su = (cudaStream_t)s_h2d_i;
+    cudaStream_t sd2 = (cudaStream_t)s_d2h2_i, su2 = (cudaStream_t)s_h2d2_i;  // reduced-shard D2H / gather H2D
+    char* xin = (char*)x.data_ptr(); char* xo = (char*)out.data_ptr(); char* scr = (char*)scratch.data_ptr();
+    char* hin = (char*)host_in; char* hred = (char*)host_red;
+    auto fin = [&](long src, long own, long p) { return (CUdeviceptr)(flags_dev + (((src * world + own) * P + p) * 8) * 8); };
+    auto fred = [&](long own, long p) { return (CUdeviceptr)(flags_dev + ((world * world * P + own * P + p) * 8) * 8); };
+    int e = 0;
+    // input ready; every copy stream joins (the previous call's reads of `scratch` / slots are done)
+    CK(cudaEventRecord(ev(e), main));
+    for (cudaStream_t st : {sd, su, sd2, su2}) CK(cudaStreamWaitEvent(st, ev(e), 0));
+    ++e;
+    // 1) publish the peers' shards of my partial (my own shard never leaves the GPU)
+    for (long k = 1; k < world; ++k) {
+        long o = (rank + k) % world;
+        for (long p = 0; p < P; ++p) {
+            long off = (o * sh + p * pc) * 2;
+            CK(cudaMemcpyAsync(hin + rank * cap * 2 + off, xin + off, pcb, cudaMemcpyDeviceToHost, sd));
+            if (o != rank) CKD(cuStreamWriteValue64((CUstream)sd, fin(rank, o, p), (cuuint64_t)epoch, 0));
+        }
+    }
+    // 2-4) owner reduce of shard `rank`
+    long peers[2] = {(rank + 1) % world, (rank + 2) % world};
+    // summation in rank order: build order mapping {own->0, peers[0]->1, peers[1]->2} sorted by rank
+    for (long p = 0; p < P; ++p) {
+        long off = (rank * sh + p * pc) * 2;
+        for (int i = 0; i < 2; ++i) {
+            CKD(cuStreamWaitValue64((CUstream)su, fin(peers[i], rank, p), (cuuint64_t)epoch, CU_STREAM_WAIT_VALUE_GEQ));
+            CK(cudaMemcpyAsync(scr + (i * sh + p * pc) * 2, hin + peers[i] * cap * 2 + off, pcb, cudaMemcpyHostToDevice, su));
+        }
+        CK(cudaEventRecord(ev(e), su)); CK(cudaStreamWaitEvent(main, ev(e), 0)); ++e;
+        long nn = pc; int threads = 256; long blocks = (nn / 8 + threads - 1) / threads;
+        sum3_bf16<<<blocks, threads, 0, main>>>((const __nv_bfloat16*)(xin + off),
+            (const __nv_bfloat16*)(scr + (0 * sh + p * pc) * 2), (const __nv_bfloat16*)(scr + (1 * sh + p * pc) * 2),
+            (__nv_bfloat16*)(xo + off), order.data_ptr<int>(), nn);
+        CK(cudaGetLastError());
+        CK(cudaEventRecord(ev(e), main)); CK(cudaStreamWaitEvent(sd2, ev(e), 0)); ++e;
+        CK(cudaMemcpyAsync(hred + off, xo + off, pcb, cudaMemcpyDeviceToHost, sd2));
+        CKD(cuStreamWriteValue64((CUstream)sd2, fred(rank, p), (cuuint64_t)epoch, 0));
+    }
+    // 5) gather the other owners' reduced shards
+    for (int i = 0; i < 2; ++i) {
+        long o = peers[i];
+        for (long p = 0; p < P; ++p) {
+            long off = (o * sh + p * pc) * 2;
+            CKD(cuStreamWaitValue64((CUstream)su2, fred(o, p), (cuuint64_t)epoch, CU_STREAM_WAIT_VALUE_GEQ));
+            CK(cudaMemcpyAsync(xo + off, hred + off, pcb, cudaMemcpyHostToDevice, su2));
+        }
+    }
+    // 6) join copy streams back into main
+    // gather writes `out` on su2 must not start before main's reduce of my shard (disjoint ranges,
+    // but out is the same allocation) -- disjoint, so only join here.
+    for (cudaStream_t st : {sd, su, sd2, su2}) {
+        CK(cudaEventRecord(ev(e), st)); CK(cudaStreamWaitEvent(main, ev(e), 0)); ++e;
+    }
+}
+
+__device__ __forceinline__ unsigned long long ld_vol_u64(const unsigned long long* p) {
+    unsigned long long v; asm volatile("ld.volatile.global.u64 %0, [%1];" : "=l"(v) : "l"(p)); return v;
+}
+__global__ void bump_epoch_kernel(unsigned long long* ep) { *ep += 1ull; }
+__global__ void flag_write_kernel(unsigned long long* flag, const unsigned long long* ep) {
+    __threadfence_system();
+    *(volatile unsigned long long*)flag = *ep;
+    __threadfence_system();
+}
+__global__ void flag_wait_kernel(const unsigned long long* flag, const unsigned long long* ep) {
+    const unsigned long long e = *ep;
+    while (ld_vol_u64(flag) < e) { }
+    __threadfence_system();
+}
+
+// Graph-capturable variant: epoch is device state (bumped per call, also on replay).
+void dma_allreduce_g(torch::Tensor x, torch::Tensor out, torch::Tensor scratch, int64_t host_in, int64_t host_red,
+                     int64_t flags_dev, int64_t cap, int64_t rank, int64_t world, torch::Tensor ep, torch::Tensor order,
+                     int64_t P, int64_t s_d2h_i, int64_t s_h2d_i, int64_t s_d2h2_i, int64_t s_h2d2_i) {
+    TORCH_CHECK(world == 3, "dma_allreduce: world 3 only");
+    const long n = x.numel();
+    TORCH_CHECK(n % (world * P * 8) == 0 && n <= cap, "dma_allreduce: bad size");
+    const long sh = n / world, pc = sh / P;
+    const size_t pcb = pc * 2;
+    cudaStream_t main = c10::cuda::getCurrentCUDAStream();
+    cudaStream_t sd = (cudaStream_t)s_d2h_i, su = (cudaStream_t)s_h2d_i;
+    cudaStream_t sd2 = (cudaStream_t)s_d2h2_i, su2 = (cudaStream_t)s_h2d2_i;
+    char* xin = (char*)x.data_ptr(); char* xo = (char*)out.data_ptr(); char* scr = (char*)scratch.data_ptr();
+    char* hin = (char*)host_in; char* hred = (char*)host_red;
+    unsigned long long* epd = (unsigned long long*)ep.data_ptr();
+    auto fin = [&](long src, long own, long p) { return (unsigned long long*)(flags_dev + (((src * world + own) * P + p) * 8) * 8); };
+    auto fred = [&](long own, long p) { return (unsigned long long*)(flags_dev + ((world * world * P + own * P + p) * 8) * 8); };
+    int e = 0;
+    bump_epoch_kernel<<<1, 1, 0, main>>>(epd);
+    CK(cudaEventRecord(ev(e), main));
+    for (cudaStream_t st : {sd, su, sd2, su2}) CK(cudaStreamWaitEvent(st, ev(e), 0));
+    ++e;
+    for (long k = 1; k < world; ++k) {
+        long o = (rank + k) % world;
+        for (long p = 0; p < P; ++p) {
+            long off = (o * sh + p * pc) * 2;
+            CK(cudaMemcpyAsync(hin + rank * cap * 2 + off, xin + off, pcb, cudaMemcpyDeviceToHost, sd));
+            flag_write_kernel<<<1, 1, 0, sd>>>(fin(rank, o, p), epd);
+        }
+    }
+    long peers[2] = {(rank + 1) % world, (rank + 2) % world};
+    for (long p = 0; p < P; ++p) {
+        long off = (rank * sh + p * pc) * 2;
+        for (int i = 0; i < 2; ++i) {
+            flag_wait_kernel<<<1, 1, 0, su>>>(fin(peers[i], rank, p), epd);
+            CK(cudaMemcpyAsync(scr + (i * sh + p * pc) * 2, hin + peers[i] * cap * 2 + off, pcb, cudaMemcpyHostToDevice, su));
+        }
+        CK(cudaEventRecord(ev(e), su)); CK(cudaStreamWaitEvent(main, ev(e), 0)); ++e;
+        long nn = pc; int threads = 256; long blocks = (nn / 8 + threads - 1) / threads;
+        sum3_bf16<<<blocks, threads, 0, main>>>((const __nv_bfloat16*)(xin + off),
+            (const __nv_bfloat16*)(scr + (0 * sh + p * pc) * 2), (const __nv_bfloat16*)(scr + (1 * sh + p * pc) * 2),
+            (__nv_bfloat16*)(xo + off), order.data_ptr<int>(), nn);
+        CK(cudaGetLastError());
+        CK(cudaEventRecord(ev(e), main)); CK(cudaStreamWaitEvent(sd2, ev(e), 0)); ++e;
+        CK(cudaMemcpyAsync(hred + off, xo + off, pcb, cudaMemcpyDeviceToHost, sd2));
+        flag_write_kernel<<<1, 1, 0, sd2>>>(fred(rank, p), epd);
+    }
+    for (int i = 0; i < 2; ++i) {
+        long o = peers[i];
+        for (long p = 0; p < P; ++p) {
+            long off = (o * sh + p * pc) * 2;
+            flag_wait_kernel<<<1, 1, 0, su2>>>(fred(o, p), epd);
+            CK(cudaMemcpyAsync(xo + off, hred + off, pcb, cudaMemcpyHostToDevice, su2));
+        }
+    }
+    for (cudaStream_t st : {sd, su, sd2, su2}) {
+        CK(cudaEventRecord(ev(e), st)); CK(cudaStreamWaitEvent(main, ev(e), 0)); ++e;
+    }
+    CK(cudaGetLastError());
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("dma_allreduce", &dma_allreduce);
+    m.def("dma_allreduce_g", &dma_allreduce_g);
+    m.def("host_register", &host_register);
+}
+"""
+
+_ext = None
+
+
+def _load():
+    global _ext
+    if _ext is None:
+        from torch.utils.cpp_extension import load_inline
+        _ext = load_inline("ink_dma_allreduce_g2", cpp_sources="", cuda_sources=_SRC,
+                           extra_cuda_cflags=["-O3"], extra_ldflags=["-lcuda"],
+                           build_directory=os.environ.get("INK_DMA_BUILD", None), verbose=False)
+    return _ext
+
+
+class DmaAllReduce:
+    """Per-TP-group instance (world 3). Tensors of bf16, numel % (3 * P * 8) == 0, <= cap."""
+
+    def __init__(self, cpu_group, rank: int, world: int, device: torch.device,
+                 cap_elems: int = 8192 * 4608, pieces: int = 4):
+        assert world == 3
+        self.rank, self.world, self.cap, self.P = rank, world, cap_elems, pieces
+        ext = _load()
+        name = [f"/ink_dma_{uuid.uuid4().hex[:12]}" if rank == 0 else None]
+        dist.broadcast_object_list(name, src=0, group=cpu_group)
+        # two flag regions: eager stream-memop path, then the graph-safe (device epoch) path
+        self.flag_region = (world * world * pieces + world * pieces) * 64
+        self.flag_bytes = 2 * self.flag_region + 4096
+        self.in_bytes = world * cap_elems * 2
+        size = self.flag_bytes + self.in_bytes + cap_elems * 2
+        path = "/dev/shm" + name[0]
+        if rank == 0:
+            fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
+            os.ftruncate(fd, size)
+            os.close(fd)
+        dist.barrier(group=cpu_group)
+        fd = os.open(path, os.O_RDWR)
+        self.mm = mmap.mmap(fd, size)
+        os.close(fd)
+        dist.barrier(group=cpu_group)
+        if rank == 0:
+            os.unlink(path)
+        buf = (ctypes.c_char * size).from_buffer(self.mm)
+        self._buf = buf
+        hp = ctypes.addressof(buf)
+        with torch.cuda.device(device):
+            dptr = ext.host_register(hp, size)
+        # flags via the device pointer; copies via host pointers (UVA)
+        self.flags_dev = dptr
+        self.host_in = hp + self.flag_bytes
+        self.host_red = hp + self.flag_bytes + self.in_bytes
+        self.epoch = 0
+        self.ep = torch.zeros(1, dtype=torch.int64, device=device)
+        peers = [(rank + 1) % world, (rank + 2) % world]
+        self.order = torch.tensor([0 if r == rank else (1 if r == peers[0] else 2) for r in range(world)],
+                                  dtype=torch.int32, device=device)
+        self.use_graph_safe = os.environ.get("INK_DMA_GRAPH_SAFE", "1") == "1"
+        self.s_d2h = torch.cuda.Stream(device=device)
+        self.s_h2d = torch.cuda.Stream(device=device)
+        self.s_d2h2 = torch.cuda.Stream(device=device)
+        self.s_h2d2 = torch.cuda.Stream(device=device)
+        self.scratch = torch.empty(2 * (cap_elems // world), dtype=torch.bfloat16, device=device)
+        self.ext = ext
+        dist.barrier(group=cpu_group)
+
+    def ok(self, x: torch.Tensor) -> bool:
+        return (x.dtype == torch.bfloat16 and x.is_contiguous() and x.numel() <= self.cap
+                and x.numel() % (self.world * self.P * 8) == 0)
+
+    def __call__(self, x: torch.Tensor, out: torch.Tensor | None = None) -> torch.Tensor:
+        out = torch.empty_like(x) if out is None else out
+        if self.use_graph_safe and torch.cuda.is_current_stream_capturing():
+            self.ext.dma_allreduce_g(x, out, self.scratch, self.host_in, self.host_red, self.flags_dev + self.flag_region,
+                                     self.cap, self.rank, self.world, self.ep, self.order, self.P,
+                                     self.s_d2h.cuda_stream, self.s_h2d.cuda_stream,
+                                     self.s_d2h2.cuda_stream, self.s_h2d2.cuda_stream)
+            if not torch.cuda.is_current_stream_capturing():
+                x.record_stream(self.s_d2h)
+                for st in (self.s_d2h2, self.s_h2d2):
+                    out.record_stream(st)
+            return out
+        # Eager: stream memops for the flags (no SM needed); the graph-safe path
+        # keeps its own flag region with a device-side epoch.
+        self.epoch += 1
+        self.ext.dma_allreduce(x, out, self.scratch, self.host_in, self.host_red, self.flags_dev,
+                               self.cap, self.rank, self.world, self.epoch, self.P,
+                               self.s_d2h.cuda_stream, self.s_h2d.cuda_stream,
+                               self.s_d2h2.cuda_stream, self.s_h2d2.cuda_stream, self.order)
+        # x / out / scratch are used on the copy streams: keep them alive until those finish
+        x.record_stream(self.s_d2h)
+        for st in (self.s_d2h2, self.s_h2d2):
+            out.record_stream(st)
+        return out
