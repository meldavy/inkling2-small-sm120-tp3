index 000000000..99a7b2c0c
--- /dev/null
+++ b/vllm/models/inkling2/ops/gemv_sm12x.py
@@ -0,0 +1,44 @@
+"""Low-M (decode) GEMV for SM12x: y[M, N] = x[M, K] @ W[N, K]^T, fp32 accumulate, M <= 16.
+Each weight tile is read once and multiplied against all rows (zero-padded to 16) with tl.dot."""
+import torch
+
+from vllm.triton_utils import tl, triton
+
+@triton.jit
+def _gemv_kernel(X, W, Y, M, N, K, stride_xm, stride_ym,
+                 BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, SPLIT_K: tl.constexpr):
+    pid_n = tl.program_id(0); pid_k = tl.program_id(1)
+    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    rm = tl.arange(0, 16)
+    nmask = rn < N
+    k_per = tl.cdiv(K, SPLIT_K * BLOCK_K) * BLOCK_K
+    k0 = pid_k * k_per
+    acc = tl.zeros((16, BLOCK_N), tl.float32)
+    for kk in range(0, k_per, BLOCK_K):
+        rk = k0 + kk + tl.arange(0, BLOCK_K)
+        kmask = rk < K
+        w = tl.load(W + rn[None, :] * K + rk[:, None], mask=nmask[None, :] & kmask[:, None], other=0.0,
+                    eviction_policy="evict_first")
+        x = tl.load(X + rm[:, None] * stride_xm + rk[None, :], mask=(rm[:, None] < M) & kmask[None, :], other=0.0)
+        acc = tl.dot(x, w, acc)
+    ymask = (rm[:, None] < M) & nmask[None, :]
+    if SPLIT_K == 1:
+        tl.store(Y + rm[:, None] * stride_ym + rn[None, :], acc.to(Y.dtype.element_ty), mask=ymask)
+    else:
+        tl.atomic_add(Y + rm[:, None] * stride_ym + rn[None, :], acc, mask=ymask)
+
+def gemv_lowm(x, w, out_dtype=None, block_n=None, block_k=None, split_k=None):
+    M, K = x.shape; N = w.shape[0]
+    assert M <= 16
+    out_dtype = out_dtype or x.dtype
+    if split_k is None:
+        split_k = 1 if N >= 2048 else max(1, min(8, 2048 // N))
+    block_n = block_n or 16
+    block_k = block_k or 256
+    if split_k > 1:
+        y = torch.zeros((M, N), dtype=torch.float32, device=x.device)
+    else:
+        y = torch.empty((M, N), dtype=out_dtype, device=x.device)
+    _gemv_kernel[(triton.cdiv(N, block_n), split_k)](x, w, y, M, N, K, x.stride(0), y.stride(0),
+                                                    block_n, block_k, split_k, num_warps=4)
+    return y if (split_k == 1 or out_dtype == torch.float32) else y.to(out_dtype)
